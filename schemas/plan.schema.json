{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "auditId": {
      "type": "string",
      "minLength": 1
    },
    "home": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "policyVersion": {
      "type": "number",
      "const": 1
    },
    "riskCeiling": {
      "type": "string",
      "enum": ["safe", "recoverable", "destructive", "experimental"]
    },
    "configDigest": {
      "type": "string",
      "minLength": 1
    },
    "auditDigest": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "const": "artifacts.remove"
              },
              "adapter": {
                "type": "string",
                "const": "artifacts"
              },
              "resourceId": {
                "type": "string",
                "minLength": 1
              },
              "risk": {
                "type": "string",
                "const": "safe"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "expectedReclaimBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "target": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "projectRoot": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "enum": [
                      "node_modules",
                      "dist",
                      "dist-runtime",
                      "build",
                      ".next",
                      ".turbo",
                      ".cache",
                      "coverage",
                      "target",
                      ".venv"
                    ]
                  },
                  "device": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "inode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "mtimeMs": {
                    "type": "number"
                  },
                  "measuredBytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "newestMtimeMs": {
                    "type": "number"
                  },
                  "fingerprint": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "projectRoot",
                  "name",
                  "device",
                  "inode",
                  "mtimeMs",
                  "measuredBytes",
                  "newestMtimeMs",
                  "fingerprint"
                ]
              }
            },
            "required": [
              "actionId",
              "type",
              "adapter",
              "resourceId",
              "risk",
              "description",
              "expectedReclaimBytes",
              "target"
            ]
          },
          {
            "type": "object",
            "properties": {
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "const": "worktree.quarantine"
              },
              "adapter": {
                "type": "string",
                "const": "git"
              },
              "resourceId": {
                "type": "string",
                "minLength": 1
              },
              "risk": {
                "type": "string",
                "const": "recoverable"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "expectedReclaimBytes": {
                "type": "number",
                "const": 0
              },
              "pendingQuarantineBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "quarantineTtlMinutes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "target": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repositoryCommonDir": {
                    "type": "string",
                    "minLength": 1
                  },
                  "head": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40,64}$"
                  },
                  "branch": {
                    "type": "string",
                    "minLength": 1
                  },
                  "device": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "inode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "mtimeMs": {
                    "type": "number"
                  },
                  "measuredBytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "newestMtimeMs": {
                    "type": "number"
                  },
                  "fingerprint": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "repositoryCommonDir",
                  "head",
                  "device",
                  "inode",
                  "mtimeMs",
                  "measuredBytes",
                  "newestMtimeMs",
                  "fingerprint"
                ]
              }
            },
            "required": [
              "actionId",
              "type",
              "adapter",
              "resourceId",
              "risk",
              "description",
              "expectedReclaimBytes",
              "pendingQuarantineBytes",
              "quarantineTtlMinutes",
              "target"
            ]
          },
          {
            "type": "object",
            "properties": {
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "const": "database.vacuum"
              },
              "adapter": {
                "type": "string",
                "const": "codex"
              },
              "resourceId": {
                "type": "string",
                "minLength": 1
              },
              "risk": {
                "type": "string",
                "const": "experimental"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "expectedReclaimBytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "backupTtlMinutes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "target": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "database": {
                    "type": "string",
                    "enum": ["state", "logs", "goals", "memories"]
                  },
                  "filename": {
                    "type": "string",
                    "enum": [
                      "state_5.sqlite",
                      "logs_2.sqlite",
                      "goals_1.sqlite",
                      "memories_1.sqlite"
                    ]
                  },
                  "device": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "inode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "mtimeMs": {
                    "type": "number"
                  },
                  "measuredBytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "pageSize": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "pageCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "freelistCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "autoVacuum": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "migrationVersion": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "tables": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "schemaDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "fingerprint": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "database",
                  "filename",
                  "device",
                  "inode",
                  "mode",
                  "mtimeMs",
                  "measuredBytes",
                  "pageSize",
                  "pageCount",
                  "freelistCount",
                  "autoVacuum",
                  "migrationVersion",
                  "tables",
                  "schemaDigest",
                  "fingerprint"
                ]
              }
            },
            "required": [
              "actionId",
              "type",
              "adapter",
              "resourceId",
              "risk",
              "description",
              "expectedReclaimBytes",
              "backupTtlMinutes",
              "target"
            ]
          }
        ]
      }
    },
    "expectedReclaimBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pendingQuarantineBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "auditId",
    "home",
    "createdAt",
    "expiresAt",
    "policyVersion",
    "riskCeiling",
    "configDigest",
    "auditDigest",
    "actions",
    "expectedReclaimBytes"
  ],
  "$id": "https://agentrinse.com/schemas/plan.schema.json",
  "title": "AgentRinse plan schema"
}
